# Do not commit your real .env. Copy this file to .env and fill values.

PORT=3002

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=master

# Shared secret p3dx-aaa sends on POST /p3dx/internal/register-expected-providers
# (X-Internal-Key header). Must match p3dx-aaa's own INTERNAL_SERVICE_KEY.
# Leave blank to disable the check (local dev default).
INTERNAL_SERVICE_KEY=

# Lets provisioned VMs `docker login ghcr.io` and pull the pre-built
# flotilla-server/client/session images instead of git-cloning and building
# from source. Optional — falls back to terraform's own variables.tf defaults.
GHCR_NAMESPACE=
GHCR_PULL_TOKEN=

# Optional: pins the participants' device-code Azure login to this Microsoft
# Entra tenant (`az login --use-device-code --tenant <id>`), so a personal
# Microsoft account that shares the work email can't be signed in instead.
# Leave blank to let Azure pick (any tenant the account belongs to).
AZURE_TENANT_ID=

# Overrides the participant-vm terraform root. Defaults to
# <this service's directory>/terraform/participant-vm — leave unset unless
# you've relocated the bundled terraform/ directory.
TERRAFORM_DIR=

# --- Flotilla join gateway ---------------------------------------------------
# INTERNAL_SERVICE_KEY above is REQUIRED (the service refuses to start without
# it): p3dx-aaa hands VM credentials over on the internal routes.
#
# The orchestrator's own Keycloak service account (client-credentials grant,
# realm role fl-orchestrator). Used for gov_layer /gateway-certs, the session
# gateway's REST API, and p3dx-aaa callbacks. Required.
KEYCLOAK_CLIENT_ID=p3dx-fl-orchestrator
KEYCLOAK_CLIENT_SECRET=
# Tokens minted for this client (VM credentials) are refused on this service.
FLOTILLA_VM_CLIENT_ID=flotilla-vm
GOV_LAYER_URL=http://localhost:8083/api/v1
AAA_URL=http://localhost:3001
# p3dx-aaa as client VMs reach it (their sidecars refresh tokens there).
AAA_PUBLIC_URL=
# Session-VM layout (created by terraform/participant-vm's cloud-init).
GATEWAY_DIR=/etc/flotilla-gateway
SIDECAR_DIR=/etc/flotilla-sidecar
VM_FLOTILLA_DIR=flotilla
GATEWAY_UID=10001
GATEWAY_REST_PORT=12345
VM_SSH_USER=azureuser
VM_SSH_PORT=22
VM_CREDENTIAL_CLAIM_TTL=30m
OWNER_WAIT_TIMEOUT=45m
GATEWAY_READY_TIMEOUT=5m

# --- Dry run (test only) -----------------------------------------------------
# Test the full FL flow on two EXISTING VMs: skips the Azure sign-in and VM
# creation, everything else (SSH key, terraform, VM setup, broker, gateway
# post-steps) runs as normal. Format: role=host,role=host (roles: user,
# data-provider). The VMs must be reachable over SSH as VM_SSH_USER from this
# machine with its default SSH identity. Leave unset for normal runs.
# DRY_RUN_VMS=user=<server-vm-host>,data-provider=<client-vm-host>
# Since .env is loaded into the process env and inherited by terraform, you
# can also point the datasets at data already on the VMs:
# TF_VAR_val_data_dir=
# TF_VAR_client_data_dir=
